# Database
DATABASE_URL="postgresql://society_user:society_password@localhost:5432/society_platform?schema=public"

# NextAuth
AUTH_SECRET="change-this-to-a-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email (Nodemailer / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@yoursociety.com"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="10"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Society Platform"

# Rubric Integration (hellorubric.com)
# Credentials are configured per-society via the Settings page in the app.
# They are stored in the database (Society.rubricSessionId / rubricSocietyId).
# Configure the credentials themselves through Settings > Rubric Integration.
#
# Encrypts the stored Rubric session at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Optional: leave blank and the session is stored in plain text. Set it if your
# database backups leave the machine, since a dump would otherwise carry a live
# Rubric credential for up to a month. Existing plaintext sessions keep working
# and are encrypted the next time they are saved or rotate. Losing this key means
# re-entering the session in Settings, nothing more.
RUBRIC_SECRET_KEY=""

# Single-society deployment (per-domain mode)
# Set this to your society's slug to run a dedicated single-society instance.
# When set, all public URLs are clean (e.g. /dashboard instead of /csesoc/dashboard)
# and access to any other society's data is blocked.
# Leave blank to run in multi-society mode (default).
SOCIETY_SLUG=""
