#!/usr/bin/env bash
# Run your own society portal. See docs/SELF_HOSTING.md.
#
#   ./portal install          set up (asks a few questions), then start
#   ./portal start | stop     start or stop everything
#   ./portal update           back up, then move to the newest version
#   ./portal autoupdate on    check for a new release each night at UPDATE_HOUR, and
#   ./portal autoupdate off   install it (and anything asked for in Settings); or stop
#   ./portal backup           back up the database and uploads now
#   ./portal restore <file>   put a backup back, replacing what's there
#   ./portal logs [service]   follow the logs (app, web, db, backup, cloudflared, caddy)
#   ./portal status           what's running
#   ./portal tick             what autoupdate runs each night
#
# Settings live in portal.env next to this script; it holds your passwords, so keep it
# safe and out of git. Every command can be run again safely: install never overwrites
# a setting that is already there. Written for bash 3.2, so it also runs on a Mac.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT/portal.env"
COMPOSE_FILE="$ROOT/deploy/docker-compose.yml"
IMAGES="ghcr.io/maahir-ahmed/portal"

say() { printf '%s\n' "$*"; }
# Docker commands that need no input get </dev/null: `compose run` reads stdin even
# with -T, and would swallow the answer to the next question.
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
ask() { # ask "Question" [default] -> answer on stdout
  local a def="${2:-}"
  # Unattended (an automatic update): nobody can answer, and an empty answer would loop
  # forever, so stop the whole run and say why. $$ is the script, not this subshell.
  if [ -n "${PORTAL_UNATTENDED:-}" ]; then
    printf 'Error: a new setting needs an answer (%s). Run ./portal update yourself.\n' "$1" >&2
    kill -TERM $$
  fi
  read -r -p "$1${def:+ [$def]}: " a || true
  printf '%s' "${a:-$def}"
}
random_hex() { od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'; }

get() { [ -f "$ENV_FILE" ] && sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1 || true; }
has() { [ -f "$ENV_FILE" ] && grep -q "^$1=" "$ENV_FILE"; }
# Appends KEY=value unless KEY is already there, so a re-run keeps every existing setting.
ensure() { has "$1" || printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"; }

compose() {
  [ -f "$ENV_FILE" ] || die "no portal.env yet. Run ./portal install first."
  local profile=() method
  method="$(get METHOD)"
  case "$method" in cloudflare | caddy) profile=(--profile "$method") ;; esac
  docker compose --env-file "$ENV_FILE" -p "$(get STACK)" -f "$COMPOSE_FILE" ${profile[@]+"${profile[@]}"} "$@"
}

check_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    case "$(uname -s)" in
      Linux)
        say "Docker isn't installed. It runs the portal and its database."
        [ "$(ask "Install it now with Docker's official script? (y/n)" y)" = y ] || die "install Docker, then run ./portal install again"
        command -v curl >/dev/null || die "curl is needed to install Docker (sudo apt install curl)"
        curl -fsSL https://get.docker.com | sudo sh
        sudo usermod -aG docker "$USER" || true
        say "Docker is installed. Log out and back in (so you can use it without sudo), then run ./portal install again."
        exit 0
        ;;
      Darwin) die "install Docker Desktop from https://www.docker.com/products/docker-desktop/, open it once, then run ./portal install again" ;;
      *) die "install Docker Desktop (https://www.docker.com/products/docker-desktop/), or on Windows use portal.ps1" ;;
    esac
  fi
  if ! docker info >/dev/null 2>&1; then
    if docker info 2>&1 | grep -qi "permission denied"; then
      die "your user can't use Docker yet. Run: sudo usermod -aG docker \$USER, log out and back in, then try again"
    fi
    die "Docker is installed but not running. Start it (Docker Desktop, or: sudo systemctl start docker) and try again"
  fi
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is missing. Update Docker, or install the docker-compose-plugin package"
  case "$(uname -m)" in
    x86_64 | amd64 | aarch64 | arm64) ;;
    armv7l | armv6l | armhf) die "this is a 32-bit system. On a Raspberry Pi, install Raspberry Pi OS (64-bit) and try again" ;;
    *) say "Warning: $(uname -m) isn't a tested processor type. Carrying on." ;;
  esac
}

port_free() { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

host_timezone() {
  local tz=""
  [ -f /etc/timezone ] && tz="$(head -n 1 /etc/timezone)"
  [ -z "$tz" ] && [ -L /etc/localtime ] && tz="$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')"
  printf '%s' "${tz:-UTC}"
}

write_settings() {
  umask 077
  [ -f "$ENV_FILE" ] && say "Found portal.env: keeping the settings already in it."

  local name slug method domain port
  name="$(get APP_NAME)"
  while [ -z "$name" ]; do name="$(ask "Your society's name (e.g. Chess Society)")"; done
  ensure APP_NAME "$name"
  slug="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//')"
  ensure SOCIETY_SLUG "${slug:-society}"
  ensure STACK portal
  has ADMIN_EMAIL || ensure ADMIN_EMAIL "$(ask "Your email, for the first account (optional)")"

  method="$(get METHOD)"
  if [ -z "$method" ]; then
    say ""
    say "How will people reach the portal?"
    say "  1) Through a Cloudflare Tunnel (recommended: works anywhere, no ports to open)"
    say "  2) My server has a public IP address, and I'll point the domain at it (Caddy)"
    say "  3) Just on this computer for now, to try it out"
    case "$(ask "Choose 1, 2 or 3" 1)" in
      1) method=cloudflare ;; 2) method=caddy ;; 3) method=local ;; *) die "choose 1, 2 or 3" ;;
    esac
    ensure METHOD "$method"
  fi

  port="$(get APP_PORT)"
  if [ -z "$port" ]; then
    port=8080
    while ! port_free "$port"; do port=$((port + 1)); done
    ensure APP_PORT "$port"
  fi
  ensure APP_BIND 127.0.0.1

  if [ "$method" = local ]; then
    ensure NEXTAUTH_URL "http://localhost:$port"
  else
    domain="$(get DOMAIN)"
    while [ -z "$domain" ]; do domain="$(ask "The web address it will live at, without https:// (e.g. portal.chesssoc.org)")"; done
    domain="${domain#https://}"; domain="${domain#http://}"; domain="${domain%%/*}"
    ensure DOMAIN "$domain"
    ensure NEXTAUTH_URL "https://$domain"
  fi
  if [ "$method" = cloudflare ] && ! has TUNNEL_TOKEN; then
    say ""
    say "Paste your Cloudflare Tunnel token (docs/SELF_HOSTING.md, \"Cloudflare Tunnel\", shows where to get it)."
    local token=""
    while [ -z "$token" ]; do token="$(ask "Tunnel token")"; done
    # The dashboard offers a whole command; keep just the token from it.
    token="${token##* }"
    ensure TUNNEL_TOKEN "$token"
  fi

  ensure AUTH_SECRET "$(random_hex 32)"
  ensure DB_PASSWORD "$(random_hex 24)"
  ensure RUBRIC_SECRET_KEY "$(head -c 32 /dev/urandom | base64 | tr -d '\n')" # base64, as src/lib/secrets.ts reads it
  ensure SETUP_TOKEN "$(random_hex 24)"
  ensure ENABLE_DEBUG_TOOLS false
  ensure DISCORD_REMINDERS on
  ensure TZ "$(host_timezone)"
  ensure BACKUP_DIR "$ROOT/backups"
  # The `1` channel: every 1.x release, never a 2.0 that might need you (images.yml).
  ensure APP_IMAGE "$IMAGES-app:1"
  ensure WEB_IMAGE "$IMAGES-web:1"
  ensure BACKUP_IMAGE "$IMAGES-backup:1"
  # Empty: a schema change that would delete data stops the app instead (compose file).
  ensure DB_PUSH_FLAGS ""
  ensure UPDATE_TOKEN "$(random_hex 24)"
  ensure UPDATE_HOUR 4
  ensure BUILD_FROM_SOURCE false
  chmod 600 "$ENV_FILE"
  mkdir -p "$(get BACKUP_DIR)"
}

# Downloads the published images, or builds them here if this checkout is set to (or
# they can't be downloaded).
get_images() {
  if [ "$(get BUILD_FROM_SOURCE)" != true ]; then
    say "Downloading the portal (a few hundred MB the first time)..."
    if compose pull; then return; fi
    # Overnight, a registry hiccup shouldn't turn into a half-hour build, kept for good.
    [ -z "${PORTAL_UNATTENDED:-}" ] || die "couldn't download the new version; trying again tomorrow"
    say ""
    say "Couldn't download the images. Building them on this computer instead: this takes"
    say "10 to 30 minutes and needs about 3 GB of free memory."
    printf 'BUILD_FROM_SOURCE=true\n' >> "$ENV_FILE" # a later line wins: get reads the last
  fi
  compose pull --ignore-buildable
  compose build
}

wait_ready() {
  say "Waiting for the portal to start (it brings the database up to date first)..."

  for _ in $(seq 1 90); do
    if compose exec -T web wget -q -O /dev/null http://app:3000/login </dev/null 2>/dev/null; then return 0; fi
    sleep 2
  done
  say "It hasn't answered after 3 minutes. See what it's doing with: ./portal logs app"
  return 1
}

cmd_install() {
  check_docker
  # A fresh clone is on main; run the install from the release the images belong to.
  if [ -z "${PORTAL_REEXEC:-}" ] && [ -d "$ROOT/.git" ] && command -v git >/dev/null 2>&1; then
    local was
    was="$(git -C "$ROOT" rev-parse HEAD)"
    update_scripts
    if [ "$(git -C "$ROOT" rev-parse HEAD)" != "$was" ]; then
      say "Using the latest release, $(git -C "$ROOT" describe --tags)."
      PORTAL_REEXEC=1 exec "$ROOT/portal" install
    fi
  fi
  write_settings
  get_images
  compose up -d --no-build --remove-orphans
  wait_ready || exit 1
  local url method
  url="$(get NEXTAUTH_URL)"
  method="$(get METHOD)"
  say ""
  say "The portal is running."
  case "$method" in
    cloudflare) say "In Cloudflare, the tunnel's public hostname $(get DOMAIN) must point to the service http://web:80." ;;
    caddy) say "Point $(get DOMAIN)'s DNS (an A record) at this server and open ports 80 and 443. The certificate arrives on its own." ;;
    local) say "It's only reachable from this computer." ;;
  esac
  say ""
  local users
  users="$(compose exec -T db psql -U society_user -d society_platform -tAc 'select count(*) from "User"' </dev/null 2>/dev/null || echo 0)"
  if [ "${users//[^0-9]/}" = 0 ]; then
    say "Finish setting up here (this link only works until the first account exists):"
    say "  $url/setup?token=$(get SETUP_TOKEN)"
  else
    say "Open it at $url"
  fi
  say ""
  if command -v crontab >/dev/null 2>&1; then
    cmd_autoupdate on
  else
    say "To install updates automatically, install cron, then run: ./portal autoupdate on"
  fi
  say ""
  say "portal.env holds your passwords: keep it safe, and back it up somewhere else too."
}

cmd_backup() {
  local out
  out="$(compose run --rm -T backup archive </dev/null | tail -n 1)"
  case "$out" in /backups/*) say "Backed up to $(get BACKUP_DIR)/${out#/backups/}" ;; *) die "the backup failed: $out" ;; esac
}

cmd_restore() {
  local file="${1:-}" dir name
  [ -n "$file" ] || die "say which backup: ./portal restore <file.tar.gz>"
  [ -f "$file" ] || die "no such file: $file"
  dir="$(get BACKUP_DIR)"
  name="$(basename "$file")"
  [ "$(cd "$(dirname "$file")" && pwd)/$name" = "$dir/$name" ] || cp "$file" "$dir/$name"

  say "Checking the backup..."
  compose run --rm -T backup validate "/backups/$name" </dev/null || die "that file isn't a backup this portal can restore"
  say ""
  say "This replaces everything in the portal (every account, request and upload) with the backup."
  [ "$(ask "Type restore to go ahead")" = restore ] || die "stopped, nothing changed"

  say "Backing up what's there now first, in case you want it back..."
  cmd_backup
  compose stop app
  if compose run --rm -T backup restore "/backups/$name" </dev/null; then
    say "Restored."
  else
    say "The restore failed and the database was left as it was."
  fi
  compose up -d --no-build app
  wait_ready
}

# The newest release on this portal's channel (the APP_IMAGE tag: 1 means v1.x.y, 1.4
# means v1.4.y), as a git tag, or nothing if there isn't one yet.
channel() { local image; image="$(get APP_IMAGE)"; image="${image:-$IMAGES-app:1}"; printf '%s' "${image##*:}"; }

newest_release() {
  local channel
  channel="$(channel)"
  git -C "$ROOT" tag -l 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
    | awk -v c="v$channel" '$0 == c || index($0, c ".") == 1' | sort -V | tail -n 1
}

# Moves the scripts and compose file to the same release as the images: the newest tag
# on the channel, not whatever is on main, so a change reaches self-hosted portals only
# when it's released. The latest channel follows main on purpose.
update_scripts() {
  local tag
  if [ "$(channel)" = latest ]; then
    git -C "$ROOT" pull --ff-only || die "couldn't update the scripts with git pull. Undo local changes to this folder and try again"
    return
  fi
  git -C "$ROOT" fetch -q --tags origin || die "couldn't check for new versions of the scripts (git fetch). Check the internet connection and try again"
  tag="$(newest_release)"
  [ -n "$tag" ] || return 0 # no release on this channel yet: stay where we are
  git -C "$ROOT" checkout -q "$tag" || die "couldn't move the scripts to $tag. Undo local changes to this folder and try again"
}

# The image IDs the three portal images point at now, "none" for one not here.
image_ids() {
  local v
  for v in APP_IMAGE WEB_IMAGE BACKUP_IMAGE; do
    printf '%s ' "$(docker image inspect -f '{{.Id}}' "$(get "$v")" 2>/dev/null || echo none)"
  done
}

# Points the three image names back at the IDs image_ids gave.
retag() {
  local id
  set -- APP_IMAGE WEB_IMAGE BACKUP_IMAGE
  for id in $IDS; do
    [ "$id" = none ] || docker tag "$id" "$(get "$1")"
    shift
  done
}

cmd_update() {
  check_docker
  local before after head="" IDS
  before="$(image_ids)"
  if [ -d "$ROOT/.git" ] && command -v git >/dev/null 2>&1; then
    head="$(git -C "$ROOT" rev-parse HEAD)"
    update_scripts
  fi
  write_settings # adds any setting a newer version needs
  get_images
  after="$(image_ids)"
  # The version just downloaded, for the portal to say which one did or didn't install.
  say "Version: $(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$(get APP_IMAGE)" 2>/dev/null | sed -n 's/^APP_VERSION=//p')"

  if [ "$before" = "$after" ]; then
    compose up -d --no-build --remove-orphans # picks up a changed compose file, if any
    say "Already up to date."
    return 0
  fi
  # A version that failed to start before isn't retried every night; a newer one is,
  # and so is this one when you run update yourself, or an executive asks for it in
  # Settings (PORTAL_RETRY).
  if [ -n "${PORTAL_UNATTENDED:-}" ] && [ -z "${PORTAL_RETRY:-}" ] && [ "$after" = "$(cat "$ROOT/.update-skip" 2>/dev/null)" ]; then
    IDS="$before" retag
    say "Skipped: this version didn't start last time. Run ./portal update to try it again."
    return 0
  fi

  say "Backing up before the update..."
  if ! (cmd_backup); then
    IDS="$before" retag
    die "the backup failed, so nothing was updated"
  fi
  compose up -d --no-build --remove-orphans
  if wait_ready; then
    rm -f "$ROOT/.update-skip"
    docker image prune -f >/dev/null
    say "Up to date."
    return 0
  fi

  say "The new version didn't start. Going back to the one before..."
  printf '%s' "$after" > "$ROOT/.update-skip"
  IDS="$before" retag
  [ -z "$head" ] || git -C "$ROOT" reset -q --keep "$head" || true
  compose up -d --no-build --remove-orphans
  wait_ready || true
  die "rolled back: the new version didn't start, and the portal is on the one before. The backup from just before is in $(get BACKUP_DIR). See why with: ./portal logs app"
}

# Talks to the portal's update endpoint from inside the web container (so it needs no
# curl here, and works however the port is published). Prints the reply.
check_in() { # check_in [result] [detail] [version]
  local body="{}" clean
  # These go into JSON: keep them to characters that need no escaping.
  clean() { printf '%s' "$1" | tr -d '"\\' | tr '\n\t' '  ' | cut -c1-400; }
  [ -z "${1:-}" ] || body="{\"result\":\"$1\",\"detail\":\"$(clean "${2:-}")\",\"version\":\"$(clean "${3:-}")\"}"
  compose exec -T web wget -q -O - -T 20 \
    --header "Authorization: Bearer $(get UPDATE_TOKEN)" --header "Content-Type: application/json" \
    --post-data "$body" http://app:3000/api/system/update </dev/null 2>/dev/null
}

# Once a night at UPDATE_HOUR (autoupdate): check in with the portal, update, and say
# how it went. "Install at the next check" in Settings only asks; this is when it happens.
cmd_tick() {
  exec </dev/null
  local lock="$ROOT/.update.lock" result="$ROOT/.update-result" reply requested out status detail version
  # Not alongside a ./portal update someone started by hand. A lock older than two hours
  # is from a run that died.
  if ! mkdir "$lock" 2>/dev/null; then
    [ -n "$(find "$lock" -maxdepth 0 -mmin +120 2>/dev/null)" ] || return 0
    rm -rf "$lock" && mkdir "$lock"
  fi
  trap "rm -rf '$lock'" EXIT # $lock expanded now: it's gone by the time the script exits

  # A result the portal hasn't heard yet (it was restarting) goes with this check-in.
  if [ -f "$result" ]; then
    reply="$(check_in "$(sed -n 1p "$result")" "$(sed -n 2p "$result")" "$(sed -n 3p "$result")")" && rm -f "$result"
  else
    reply="$(check_in || true)"
  fi

  requested=""
  case "$reply" in *'"requested":true'*) requested=1 ;; esac

  say "--- $(date) update"
  # Its own process, so a question it can't ask (PORTAL_UNATTENDED) ends only that.
  out="$(PORTAL_UNATTENDED=1 PORTAL_RETRY="$requested" "$ROOT/portal" update 2>&1)" && status=ok || status=failed
  printf '%s\n' "$out"
  # Nothing new, or only the version that failed before: a nightly run that did nothing
  # has nothing to report, and mustn't paper over how the last real update went.
  if [ -z "$requested" ] && [ "$status" = ok ]; then
    case "$out" in *"Already up to date."* | *"Skipped:"*) return 0 ;; esac
  fi
  case "$out" in *"rolled back:"*) status=rolled_back ;; esac
  detail="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n 1 | sed 's/^Error: //')"
  version="$(printf '%s\n' "$out" | sed -n 's/^Version: //p' | tail -n 1)"
  printf '%s\n%s\n%s\n' "$status" "$detail" "$version" > "$result"
  check_in "$status" "$detail" "$version" >/dev/null && rm -f "$result" || true
}

# The crontab line for this folder, marked so `off` finds exactly it.
CRON_MARK="# society-portal $ROOT"

cmd_autoupdate() {
  command -v crontab >/dev/null 2>&1 || die "crontab isn't installed (on Debian or Ubuntu: sudo apt install cron)"
  local others path hour
  others="$(crontab -l 2>/dev/null | grep -vF "$CRON_MARK" || true)"
  # cron's own PATH is tiny and misses Docker on a Mac (/usr/local/bin): add its folder.
  path="$(dirname "$(command -v docker || echo /usr/bin/docker)"):/usr/local/bin:/usr/bin:/bin"
  case "${1:-}" in
    on)
      hour="$(get UPDATE_HOUR)"
      case "$hour" in [0-9] | 1[0-9] | 2[0-3]) ;; *) die "UPDATE_HOUR in portal.env must be an hour, 0 to 23" ;; esac
      printf '%s\n%s\n' "$others" "0 $hour * * * cd '$ROOT' && PATH='$path' ./portal tick >> '$ROOT/update.log' 2>&1 $CRON_MARK" \
        | sed '/^$/d' | crontab -
      say "Automatic updates are on: each night at $hour:00 the server checks for a new release"
      say "and installs it after a backup. To install one straight away, run ./portal update."
      say "After changing UPDATE_HOUR, run ./portal autoupdate on again. Log: update.log"
      ;;
    off)
      if [ -n "$others" ]; then printf '%s\n' "$others" | crontab -; else crontab -r 2>/dev/null || true; fi
      say "Automatic updates are off. Update with ./portal update."
      ;;
    *) die "say on or off: ./portal autoupdate on" ;;
  esac
}

case "${1:-}" in
  install) cmd_install ;;
  start) compose up -d --no-build && wait_ready ;;
  stop) compose stop ;;
  update) cmd_update ;;
  tick) cmd_tick ;;
  autoupdate) cmd_autoupdate "${2:-}" ;;
  backup) cmd_backup ;;
  restore) cmd_restore "${2:-}" ;;
  logs) compose logs -f --tail 200 ${2:+"$2"} ;;
  status) compose ps ;;
  *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
