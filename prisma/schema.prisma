generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  EXECUTIVE
  DIRECTOR
  SUBCOMMITTEE
}

enum ContentRequestStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  AWAITING_INFORMATION
  COMPLETED
  CANCELLED
}

// Arc activity grant lifecycle for an event (tracked per content request).
enum ActivityGrantStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum RoomBookingStatus {
  SUBMITTED
  UNDER_REVIEW
  WAITING_ON_INFORMATION
  SUBMITTED_TO_ARC
  APPROVED
  REJECTED
  COMPLETED
}

// Spending is approved in the committee Discord, not here. A submitted claim goes
// straight into the payout queue; the website only tracks the reimbursement.
enum TreasuryStatus {
  DRAFT
  REIMBURSEMENT_PENDING
  REJECTED
  REIMBURSED
}

enum PreferredLocation {
  LECTURE_THEATRE
  CATS_ROOM
  SECLAB
  ROUNDHOUSE
  OUTDOOR_SPACE
  OTHER
}

// Flow: PENDING_APPROVAL -> (exec approves) PENDING_ARC_SUBMISSION -> (submitted
// on the Arc web portal) SUBMITTED -> READY_FOR_PICKUP. Rejection is terminal.
enum PrintingStatus {
  PENDING_APPROVAL
  PENDING_ARC_SUBMISSION
  SUBMITTED
  READY_FOR_PICKUP
  REJECTED
}

enum SecretarialTier {
  BRONZE
  SILVER
  GOLD
}

// Columns of the executive board. Fixed set: it is a to-do board, not a workflow.
enum BoardLane {
  TODO
  DOING
  DONE
}

// Arc's Clubs Contributing Members Recognition (AHEGS) categories. The society's
// own roles map straight onto them: directors are the club's mentors. Volunteers are
// a fourth Arc category this club doesn't submit for.
enum AhegsCategory {
  EXECUTIVE
  MENTOR
  SUBCOMMITTEE
}

// The supporting documents Arc asks for alongside the mentor and sub-committee
// lists. Each is either an uploaded file or a link to one.
enum AhegsEvidenceKind {
  TRAINING
  ATTENDANCE
  COMMITMENT
}

enum NotificationType {
  ASSIGNMENT
  APPROVAL_REQUIRED
  STATUS_CHANGE
  COMMENT
  MENTION
  DEADLINE_REMINDER
  EXECUTIVE_ACTION_REQUIRED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  ASSIGN
  STATUS_CHANGE
  COMMENT
  LOGIN
  LOGOUT
}

// ─── Core entities ─────────────────────────────────────────────────────────────

model Society {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  bannerUrl      String?
  primaryColor   String   @default("#0052CC")
  secondaryColor String   @default("#00B8D9")
  contactEmail         String?
  website              String?
  facebookUrl          String?
  instagramUrl         String?
  discordUrl           String?
  linkedinUrl          String?
  description          String?
  // Encrypted at rest when RUBRIC_SECRET_KEY is set (src/lib/rubric.ts). Never
  // selected into an API response; the credentials route reports only whether it
  // is configured, and how old it is (Rubric expires sessions after ~a month).
  rubricSessionId        String?
  rubricSessionUpdatedAt DateTime?
  rubricSocietyId        String?
  rubricUnionSessionId   String?
  secretarialTier      SecretarialTier @default(BRONZE)
  // The academic year AHEGS is being collated for. Set in Settings because it does
  // not follow the calendar: a submission is prepared over one year and lodged at its
  // end, so the page must not roll over to a new, empty year on 1 January. Null falls
  // back to the calendar year.
  ahegsYear            Int?
  createdAt            DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships      SocietyMembership[]
  portfolios       Portfolio[]
  titles           SocietyTitle[]
  contentRequests  ContentRequest[]
  roomBookings     RoomBooking[]
  treasuryRequests TreasuryRequest[]
  printingRequests PrintingRequest[]
  announcements    Announcement[]
  auditLogs        AuditLog[]
  budgetCategories BudgetCategory[]
  boardCards       BoardCard[]
  ahegsEntries     AhegsEntry[]
  ahegsEvidence    AhegsEvidence[]
  ahegsMeetings    AhegsMeeting[]
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String?
  // Set when an executive issues a temporary passphrase (new member, or a reset).
  // The app blocks on a change-password dialog until the user picks their own.
  mustChangePassword Boolean @default(false)
  avatarUrl        String?
  phone            String?
  zId              String?
  emailVerified    DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  memberships       SocietyMembership[]
  accounts          Account[]
  sessions          Session[]
  notifications     Notification[]
  comments          Comment[]
  contentRequests   ContentRequest[]     @relation("ContentRequestSubmitter")
  assignedContent   ContentRequest[]     @relation("ContentRequestAssignee")
  roomBookings      RoomBooking[]        @relation("RoomBookingSubmitter")
  assignedRooms     RoomBooking[]        @relation("RoomBookingAssignee")
  treasuryRequests  TreasuryRequest[]    @relation("TreasurySubmitter")
  printingRequests  PrintingRequest[]    @relation("PrintingSubmitter")
  bankAccounts      BankAccount[]
  auditLogs         AuditLog[]
  boardCards        BoardCard[]
  ahegsMeetings     AhegsMeeting[]
}

model SocietyMembership {
  id           String   @id @default(cuid())
  userId       String
  societyId    String
  role         Role     @default(SUBCOMMITTEE)
  portfolioId  String?
  title        String?
  isActive     Boolean  @default(true)
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  society     Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  portfolio   Portfolio?   @relation(fields: [portfolioId], references: [id])
  ahegsEntries AhegsEntry[]
  ahegsAttendance AhegsAttendance[]

  @@unique([userId, societyId])
  @@index([societyId])
  @@index([userId])
}

// An area of the committee (Careers, Creatives, CTF, ...). Each one has a director
// title and a subcom title; a member's portfolio follows from the title they hold,
// so it is never set directly. Executives are grouped by role and hold none.
model Portfolio {
  id        String   @id @default(cuid())
  societyId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  society     Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  memberships SocietyMembership[]
  titles      SocietyTitle[]
  ahegsMeetings AhegsMeeting[]

  @@unique([societyId, name])
}

// ─── Auth (NextAuth) ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Content Requests ─────────────────────────────────────────────────────────

model ContentRequest {
  id              String               @id @default(cuid())
  societyId       String
  submittedById   String
  assignedToId    String?
  eventName       String
  startDate       DateTime
  endDate         DateTime?
  location        String
  keyPoints       String               @db.Text
  deadline        DateTime
  bannerRequired  Boolean              @default(false)
  blurbRequired   Boolean              @default(false)
  rubricRequired  Boolean              @default(false)
  otherNotes      String?              @db.Text
  status          ContentRequestStatus @default(DRAFT)
  rubricEventLink String?
  rubricQrCodeUrl String?
  rubricEventId   String?
  rubricSubmittedAt DateTime?
  activityGrantStatus ActivityGrantStatus @default(NOT_SUBMITTED)
  finishedBlurb   String?              @db.Text   // marketing pastes the final event blurb here
  bannerDone      Boolean              @default(false)
  blurbDone       Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  society      Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  submittedBy  User    @relation("ContentRequestSubmitter", fields: [submittedById], references: [id])
  assignedTo   User?   @relation("ContentRequestAssignee", fields: [assignedToId], references: [id])
  thread       Thread?
  deliverables ContentDeliverable[]

  @@index([societyId])
  @@index([status])
}

// Finished graphics/banners uploaded by marketing, for download.
model ContentDeliverable {
  id               String   @id @default(cuid())
  contentRequestId String
  fileName         String
  fileUrl          String
  uploadedAt       DateTime @default(now())

  contentRequest ContentRequest @relation(fields: [contentRequestId], references: [id], onDelete: Cascade)

  @@index([contentRequestId])
}

// ─── Room Bookings ────────────────────────────────────────────────────────────

model RoomBooking {
  id                 String            @id @default(cuid())
  societyId          String
  submittedById      String
  assignedToId       String?
  eventName          String
  preferredDate      DateTime
  startTime          String
  endTime            String
  description        String            @db.Text
  maxAttendees       Int
  hasExternalGuests  Boolean           @default(false)
  externalGuestsDesc String?           @db.Text
  numExternalGuests  Int?
  preferredLocation  PreferredLocation
  safetyOfficerName  String
  safetyOfficerZid   String
  safetyOfficerPhone String
  roomRequirements   String            @db.Text
  status             RoomBookingStatus @default(SUBMITTED)
  submittedToArcAt   DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  society     Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  submittedBy User    @relation("RoomBookingSubmitter", fields: [submittedById], references: [id])
  assignedTo  User?   @relation("RoomBookingAssignee", fields: [assignedToId], references: [id])
  thread      Thread?

  @@index([societyId])
  @@index([status])
}

// ─── Treasury Requests ────────────────────────────────────────────────────────

model TreasuryRequest {
  id               String         @id @default(cuid())
  societyId        String
  submittedById    String
  contactEmail     String
  expenseDate      DateTime
  locationSupplier String
  description      String         @db.Text
  amount           Decimal        @db.Decimal(10, 2)
  bankAccountId    String?
  budgetCategoryId String?
  status           TreasuryStatus @default(DRAFT)
  acknowledgedRules Boolean       @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  society        Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  submittedBy    User                 @relation("TreasurySubmitter", fields: [submittedById], references: [id])
  bankAccount    BankAccount?         @relation(fields: [bankAccountId], references: [id])
  budgetCategory BudgetCategory?      @relation(fields: [budgetCategoryId], references: [id], onDelete: SetNull)
  receipts       TreasuryAttachment[]
  thread         Thread?

  @@index([societyId])
  @@index([status])
  @@index([budgetCategoryId])
}

model TreasuryAttachment {
  id                String   @id @default(cuid())
  treasuryRequestId String
  fileName          String
  fileUrl           String
  fileSize          Int
  mimeType          String
  isEventPhoto      Boolean  @default(false)
  uploadedAt        DateTime @default(now())

  treasuryRequest TreasuryRequest @relation(fields: [treasuryRequestId], references: [id], onDelete: Cascade)
}

model PrintingRequest {
  id              String         @id @default(cuid())
  societyId       String
  submittedById   String
  clubName        String
  contactName     String
  contactEmail    String
  contactPhone    String
  pickupAt        DateTime
  quantity        Int
  pages           Int
  paperSize       String         // "A4" | "A3"
  sided           String         // "SINGLE" | "DOUBLE_SHORT" | "DOUBLE_LONG"
  colour          String         // "BW" | "COLOUR"
  fileUrl         String
  fileName        String
  additionalDetails String?      @db.Text
  cost            Decimal        @db.Decimal(10, 2)
  status          PrintingStatus @default(PENDING_APPROVAL)
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  society     Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  submittedBy User    @relation("PrintingSubmitter", fields: [submittedById], references: [id])

  @@index([societyId])
  @@index([status])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  accountName   String
  bsb           String
  accountNumber String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  treasuryRequests TreasuryRequest[]
}

// ─── Society Titles ───────────────────────────────────────────────────────────

// The title a member holds, which is what puts them in a portfolio. Executive
// titles have no portfolio.
model SocietyTitle {
  id          String   @id @default(cuid())
  societyId   String
  portfolioId String?
  name        String
  roleLevel   Role
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  society   Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  portfolio Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  @@unique([societyId, name, roleLevel])
  @@index([societyId])
}

// ─── Thread / Forum ───────────────────────────────────────────────────────────

model Thread {
  id                String  @id @default(cuid())
  contentRequestId  String? @unique
  roomBookingId     String? @unique
  treasuryRequestId String? @unique
  createdAt         DateTime @default(now())

  contentRequest  ContentRequest?  @relation(fields: [contentRequestId], references: [id])
  roomBooking     RoomBooking?     @relation(fields: [roomBookingId], references: [id])
  treasuryRequest TreasuryRequest? @relation(fields: [treasuryRequestId], references: [id])
  comments        Comment[]
}

model Comment {
  id         String   @id @default(cuid())
  threadId   String
  authorId   String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  thread      Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User                @relation(fields: [authorId], references: [id])
  attachments CommentAttachment[]

  @@index([threadId])
}

model CommentAttachment {
  id        String @id @default(cuid())
  commentId String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  // Delete handlers clean up stale notifications by link.
  @@index([link])
}

// ─── Announcements ────────────────────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  societyId String
  title     String
  content   String   @db.Text
  authorId  String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId])
}

// ─── Spending Budget ──────────────────────────────────────────────────────────

// A budget line for the society's year-by-year planning + live tracking.
// yearlyBudget is the current (2026) budget; treasury requests classified into
// this category are summed as the live spend and compared against it. The other
// columns are the historical planning figures + rationale, all editable in-app.
model BudgetCategory {
  id           String   @id @default(cuid())
  societyId    String
  name         String
  group        String   @default("PORTFOLIO") // "PORTFOLIO" | "OTHER", for subtotals
  yearlyBudget Decimal  @default(0) @db.Decimal(10, 2) // the current-year (2026) budget
  budget2024   Decimal? @db.Decimal(10, 2)
  budget2024v2 Decimal? @db.Decimal(10, 2)
  budget2025   Decimal? @db.Decimal(10, 2)
  usage2025    Decimal? @db.Decimal(10, 2)
  worstCase    Decimal? @db.Decimal(10, 2)
  reasoning    String?  @db.Text
  notes        String?  @db.Text
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  society          Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  treasuryRequests TreasuryRequest[]

  @@unique([societyId, name])
  @@index([societyId])
}

// ─── AHEGS ────────────────────────────────────────────────────────────────────

// One person on one year's AHEGS submission. The roster is derived from the member
// directory, so a row only exists here once it has been touched: to drop someone
// from the submission, or to correct what Arc sees. Every text field is an override
// — null means "use the membership's own value", so a later name or title change
// still flows through.
model AhegsEntry {
  id           String        @id @default(cuid())
  societyId    String
  membershipId String
  year         Int
  category     AhegsCategory
  included     Boolean       @default(true)
  // Arc matches on the name as printed on the Student ID, which is often not the
  // name someone uses day to day, hence an override rather than a directory edit.
  fullName     String?
  zid          String?
  email        String?
  position     String?
  startDate    DateTime?
  endDate      DateTime?
  // Contribution outside scheduled meetings (running an event, marking a CTF). Added
  // to the hours derived from meeting attendance; may be negative to correct one.
  hoursAdjustment Float?
  updatedAt    DateTime      @updatedAt

  society    Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  membership SocietyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, year])
  @@index([societyId, year])
}

// Training resources, attendance records and proof of commitment, per category per
// year. Arc wants one combined file for each, so there is at most one row per slot.
model AhegsEvidence {
  id        String            @id @default(cuid())
  societyId String
  year      Int
  category  AhegsCategory
  kind      AhegsEvidenceKind
  // An /uploads/… path or an external link; Arc accepts either for training resources.
  url       String
  label     String?
  updatedAt DateTime          @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([societyId, year, category, kind])
}

// A meeting a portfolio ran, with its minutes attached. Directors log these through
// the year; the hours each member is credited with are summed from the meetings they
// attended, so the number always has the minutes standing behind it.
//
// Arc's templates have no hours column — hours decide who the club puts forward,
// and the minutes are what Arc asks for as proof of commitment.
model AhegsMeeting {
  id          String   @id @default(cuid())
  societyId   String
  // Null for a whole-of-committee meeting; otherwise the portfolio that ran it, which
  // is also what decides who can see and edit it.
  portfolioId String?
  // The executive team's own meetings. Execs hold no portfolio, so they can't be
  // grouped by one; this is their equivalent. Implies portfolioId is null, and like
  // any portfolio-less meeting it is visible to executives only.
  execTeam    Boolean  @default(false)
  year        Int
  title       String
  date        DateTime
  // Duration in hours. Float rather than Decimal: this is not money, and the halves
  // and quarters people actually record are exact in binary anyway.
  hours       Float    @default(1)
  fileUrl     String?
  fileName    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  society   Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  portfolio Portfolio?        @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  createdBy User              @relation(fields: [createdById], references: [id])
  attendees AhegsAttendance[]

  @@index([societyId, year])
  @@index([portfolioId])
}

// Who was at a meeting. The join is what turns logged meetings into per-person hours.
model AhegsAttendance {
  id           String @id @default(cuid())
  meetingId    String
  membershipId String

  meeting    AhegsMeeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membership SocietyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([meetingId, membershipId])
  @@index([membershipId])
}

// ─── Executive Board ──────────────────────────────────────────────────────────

// A Trello-style board for the exec team: things to do and things coming up. It is
// deliberately not linked to requests — those have their own queues and statuses.
// Cards are shared by the whole exec team, so there is no per-user board.
model BoardCard {
  id          String    @id @default(cuid())
  societyId   String
  createdById String
  lane        BoardLane @default(TODO)
  title       String
  notes       String?   @db.Text
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([societyId, lane])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  societyId  String?
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  society Society? @relation(fields: [societyId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@index([societyId, entityType])
  @@index([userId])
}
