# Copy to deploy/.env.dev on the server and fill in. Do NOT commit the real file.
STACK=rubric_dev
APP_PORT=3001          # host port cloudflared points at (host.docker.internal:3001)
NEXTAUTH_URL=https://demo.example.com
AUTH_SECRET=          # generate: openssl rand -base64 32  (use a DIFFERENT secret than prod)
DB_PASSWORD=          # generate: openssl rand -hex 24   (hex is URL-safe; avoid / + = which break DATABASE_URL)
SOCIETY_SLUG=
APP_NAME=Society Portal (demo)

# Public demo: the login page signs visitors straight in as DEMO_EMAIL.
# Only turn this on for a stack whose database holds seed data and whose society
# has no Rubric credentials. See deploy/README.md.
DEMO_MODE=1
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo      # public by design

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# Backups: where the backup service writes dumps and uploads archives. Absolute, so
# it does not depend on which directory compose was run from.
BACKUP_DIR=/home/maahir/containers/rubric-backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
